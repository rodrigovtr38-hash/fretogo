rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 🔐 HELPERS E SEGURANÇA MESTRE
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 🔥 CHAVE MESTRA ORIGINAL (Admin)
    function isAdmin() {
      return isAuthenticated() && request.auth.uid in [
        "uV1yeZoGfhZTRWDVL1CnMW6b6NY2"
      ];
    }

    function isQATester() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true && (
        request.auth.token.email == "contato@fretogo.com.br" ||
        request.auth.token.email == "rodrigovtr38@gmail.com"
      );
    }

    // =========================================================
    // 🚚 MOTORISTAS CADASTROS (APROVAÇÃO)
    // =========================================================

    match /motoristas_cadastros/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isQATester();
      allow create: if isOwner(userId);
      allow update: if
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'score', 'taxaAceite', 'totalCorridas', 'aprovado', 'status', 'riscoFraude', 'validacaoManual'
        ])) 
        || isAdmin() || isQATester();
      allow delete: if false;
    }

    // =========================================================
    // 📡 MOTORISTAS ONLINE (RADAR)
    // =========================================================

    match /motoristas_online/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================
    // 📦 FRETES (BLINDAGEM CONTRA ROUBO DE DADOS E FRAUDE)
    // =========================================================

    match /fretes/{freteId} {
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.motoristaId == request.auth.uid ||
        ((resource.data.status == 'disponivel' || resource.data.status == 'buscando_motorista') &&
          resource.data.pagamentoStatus == 'aprovado') ||
        isAdmin() || isQATester()
      );

      allow create: if false; 

      allow update: if
        // 🔥 CTO FIX (NOVO-01): Admin NÃO PODE liquidar direto pelo frontend (bloqueio nos campos financeiros-chave).
        ((isAdmin() || isQATester()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['chavePixMotorista', 'liquidadoEm', 'repasseEfetuado'])) 
        ||
        // Navegador do motorista grava somente telemetria e evidência. Aceite, progressão, PIN e liquidação são exclusivos do backend.
        (isAuthenticated() && 
         resource.data.motoristaId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'motoristaLat', 'motoristaLng', 'motoristaHeading',
           'gpsFalhou', 'heartbeat', 'atualizadoEm', 'updatedAt'
         ]))
        ||
        // Liberação de Auto-Bid Blindada
        (isAuthenticated() &&
         resource.data.clienteId == request.auth.uid &&
         (resource.data.status == 'expirado' || resource.data.status == 'sem_motorista' || resource.data.status == 'disponivel') &&
         request.resource.data.status == 'disponivel' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'valorTotal', 'prioridade', 'ofertaExpiraEm', 'createdAt', 'updatedAt'
         ]));

      allow delete: if isAdmin() || isQATester();
      
      // 🔥 CTO FIX (F01): Blindagem Zero-Trust. PINs migrados para subcoleção isolada. Motorista NUNCA pode ler esta coleção.
      match /secrets/{secretId} {
        allow read: if isAdmin() || isQATester() || (isAuthenticated() && get(/databases/$(database)/documents/fretes/$(freteId)).data.clienteId == request.auth.uid);
        allow write: if false; 
      }

      match /chat/{mensagemId} {
        allow read, create: if isAuthenticated() && (
          get(/databases/$(database)/documents/fretes/$(freteId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/fretes/$(freteId)).data.motoristaId == request.auth.uid ||
          isAdmin() || isQATester()
        );
        allow update, delete: if false;
      }
    }

    // =========================================================
    // 🎯 OFERTAS E FILAS
    // =========================================================

    match /ofertas/{ofertaId} {
      allow read: if isAuthenticated() && resource.data.motoristaId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.motoristaId == request.auth.uid;
      allow create, delete: if isAdmin() || isQATester();
    }

    match /analytics_demand/{docId} {
      allow read: if isAdmin() || isQATester();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
