rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 🔐 HELPERS E SEGURANÇA MESTRE
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 🔥 CHAVE MESTRA ORIGINAL (Admin)
    function isAdmin() {
      return isAuthenticated() && request.auth.uid in [
        "uV1yeZoGfhZTRWDVL1CnMW6b6NY2"
      ];
    }

    // 🔥 CTO FIX: BLINDAGEM DE HOMOLOGAÇÃO (BLOCO 2 E 5)
    function isQATester() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true && (
        request.auth.token.email == "contato@fretogo.com.br" ||
        request.auth.token.email == "rodrigovtr38@gmail.com"
      );
    }

    // =========================================================
    // 🚚 MOTORISTAS CADASTROS (APROVAÇÃO)
    // =========================================================

    match /motoristas_cadastros/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isQATester();
      allow create: if isOwner(userId);
      allow update: if
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'score', 'taxaAceite', 'totalCorridas', 'aprovado', 'status', 'riscoFraude', 'validacaoManual'
        ])) 
        || isAdmin() || isQATester();
      allow delete: if false;
    }

    // =========================================================
    // 📡 MOTORISTAS ONLINE (RADAR)
    // =========================================================

    match /motoristas_online/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================
    // 📦 FRETES (BLINDAGEM CONTRA ROUBO DE DADOS E FRAUDE)
    // =========================================================

    match /fretes/{freteId} {
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.motoristaId == request.auth.uid ||
        resource.data.status == 'disponivel' ||
        resource.data.status == 'buscando_motorista' ||
        isAdmin() || isQATester()
      );

      // 🔥 CTO FIX (PATCH BLOCO 01): BLOQUEADO NO FRONTEND. CRIAÇÃO SOMENTE VIA CLOUD FUNCTION.
      allow create: if false; 

      allow update: if
        isAdmin() || isQATester() 
        ||
        // O Feed contém apenas fretes pagos. O motorista aceita e vincula a operação diretamente.
        (isAuthenticated() && 
         resource.data.status in ['disponivel', 'buscando_motorista'] &&
         resource.data.pagamentoStatus == 'aprovado' &&
         request.resource.data.pagamentoStatus == resource.data.pagamentoStatus &&
         (!('motoristaId' in resource.data) || resource.data.motoristaId == null) &&
         request.resource.data.status == 'aceito' && 
         request.resource.data.motoristaId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'motoristaId', 'motoristaNome', 'motoristaTelefone', 'motoristaVeiculo', 
           'motoristaPlaca', 'motoristaZap', 'veiculo', 'placa', 'foto', 'avaliacao',
           'reservadoEm', 'reservaExpiraEm', 'paradaAtualIndex', 'runtime',
           'atualizadoEm', 'updatedAt'
         ]))
        ||
        // 🔥 CTO FIX: Blindagem Zero Trust para Foto+PIN
        (isAuthenticated() && 
         resource.data.motoristaId == request.auth.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'valorTotal', 'valorMotorista', 'valorFreteBruto', 'valorLiquidoMotorista', 
          'lucroPlataforma', 'valorPedagio', 'clienteNome', 'clienteZap', 'clienteId',
          'distancia', 'origemLat', 'origemLng', 'destinoLat', 'destinoLng',
          'origem', 'destino', 'coleta', 'entrega', 'paradas', 'cidadeOrigem', 'cidadeDestino',
          'enderecoColetaTexto', 'enderecoEntregaTexto', 'clienteDocumento', 'empresaDocumento',
          'motoristaId', 'motoristaNome', 'motoristaTelefone', 'motoristaZap', 'motoristaVeiculo',
          'motoristaPlaca', 'pagamentoStatus', 'pagamentoId', 'transactionId', 'pagoEm',
          'pinColeta', 'pinEntregas', 'tentativasPin', 'bloqueioPin', 'paradaAtualIndex'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          !(request.resource.data.status in [
            'aguardando_pagamento', 'reservado_aguardando_pagamento', 'pagamento_aprovado',
            'aceito', 'em_transporte', 'finalizando', 'entregue', 'finalizado'
          ])
        ))
        ||
        // 🔥 CTO FIX (PATCH BLOCO 01): Liberação de Auto-Bid Blindada (Margem, lucro e comissão bloqueados no front)
        (isAuthenticated() &&
         resource.data.clienteId == request.auth.uid &&
         (resource.data.status == 'expirado' || resource.data.status == 'sem_motorista' || resource.data.status == 'disponivel') &&
         request.resource.data.status == 'disponivel' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'valorTotal', 'prioridade', 'ofertaExpiraEm', 'createdAt', 'updatedAt'
         ]));

      allow delete: if isAdmin() || isQATester();
      
      // Liberação para a Coleção Filha de Chat FTI
      match /chat/{mensagemId} {
        allow read, create: if isAuthenticated() && (
          get(/databases/$(database)/documents/fretes/$(freteId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/fretes/$(freteId)).data.motoristaId == request.auth.uid ||
          isAdmin() || isQATester()
        );
        allow update, delete: if false;
      }
    }

    // =========================================================
    // 🎯 OFERTAS E FILAS
    // =========================================================

    match /ofertas/{ofertaId} {
      allow read: if isAuthenticated() && resource.data.motoristaId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.motoristaId == request.auth.uid;
      allow create, delete: if isAdmin() || isQATester();
    }

    match /analytics_demand/{docId} {
      allow read: if isAdmin() || isQATester();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
